# Endereço público do app (sem barra no final). Ex.: https://syncagenda.vercel.app
APP_BASE_URL=
# E-mails Microsoft autorizados a entrar no painel, separados por vírgula
ALLOWED_EMAILS=
# Segredos aleatórios: gere cada um com  npm run gen:secret
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
# Microsoft Entra (Azure): app registration single-tenant
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Google Cloud: OAuth Client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Período de transição do Zapier: eventos do Outlook com este texto na descrição são ignorados.
# Deixe vazio para desligar.
IGNORE_OUTLOOK_DESCRIPTION_CONTAINS=Agendado via Calendly
